<?xml version="1.0" encoding="utf-8"?>
<!-- Intent targetPackage must be literal: Android does not resolve @string here. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
    android:enabled="true"
    android:icon="@drawable/calendar_widget_shortcut_add"
    android:shortcutId="add_calendar_widget"
    android:shortcutLongLabel="@string/calendar_widget_shortcut_add_long"
    android:shortcutShortLabel="@string/calendar_widget_shortcut_add">
    <intent
      android:action="android.intent.action.VIEW"
      android:targetClass="com.licham.widget.CalendarWidgetPinActivity"
      android:targetPackage="com.licham.mobile" />
  </shortcut>
  <shortcut
    android:enabled="true"
    android:icon="@drawable/calendar_widget_shortcut_settings"
    android:shortcutId="customize_calendar_widget"
    android:shortcutLongLabel="@string/calendar_widget_shortcut_settings_long"
    android:shortcutShortLabel="@string/calendar_widget_shortcut_settings">
    <intent
      android:action="android.intent.action.VIEW"
      android:data="licham://settings/widget"
      android:targetClass="com.licham.mobile.MainActivity"
      android:targetPackage="com.licham.mobile" />
  </shortcut>
</shortcuts>
