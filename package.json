{
  "name": "lich-am",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "npm run start --workspace=@lich-am/mobile",
    "dev:desktop": "npm run dev --workspace=@lich-am/desktop",
    "build": "turbo run build",
    "build:pipeline": "node scripts/pipeline.mjs",
    "build:all": "node scripts/pipeline.mjs --target all",
    "build:android": "node scripts/pipeline.mjs --target android",
    "build:desktop": "node scripts/pipeline.mjs --target desktop",
    "release:android": "npm run release:android --workspace=@lich-am/mobile",
    "release:android:apk": "npm run release:android:apk --workspace=@lich-am/mobile",
    "release:ios": "npm run release:ios --workspace=@lich-am/mobile",
    "release:macos": "npm run release:macos --workspace=@lich-am/desktop",
    "release:windows": "npm run release:windows --workspace=@lich-am/desktop",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "version:sync": "node scripts/pipeline.mjs --dry-run",
    "version:mobile": "node apps/mobile/scripts/mobile-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "turbo": "^2.10.12",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || >=24.3.0"
  },
  "packageManager": "npm@10.9.7"
}
